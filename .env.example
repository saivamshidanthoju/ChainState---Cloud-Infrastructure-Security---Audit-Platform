# ChainState Platform Configuration
# Set DEMO_MODE=true for local standalone demo without AWS/Fabric/Postgres dependencies
DEMO_MODE=true

# Application
APP_NAME="ChainState – Cloud Infrastructure Security & Audit Platform"
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Database (Default: SQLite for instant local zero-dependency run; PostgreSQL for production)
DATABASE_URL=sqlite:///./chainstate.db
# PostgreSQL example for REAL mode or Docker Compose:
# DATABASE_URL=postgresql://chainstate:chainstate_secure_pass@localhost:5432/chainstate_db

# Security & Authentication
JWT_SECRET_KEY=change_me_super_secret_chainstate_key_development_only_84920
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AWS Integration (Used when DEMO_MODE=false)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Hyperledger Fabric (Used when DEMO_MODE=false)
FABRIC_CONNECTION_PROFILE_PATH=
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_CHANNEL=chainstate-channel
FABRIC_CHAINCODE=audit_contract
FABRIC_MSP_ID=Org1MSP

# Checkov & Terraform Tools
CHECKOV_ENABLED=true
TERRAFORM_BIN=terraform
